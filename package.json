{
	"name": "@idleberg/yeoman-generator",
	"version": "0.3.1",
	"description": "An opinionated drop-in replacement for Yeoman generators, using modern libraries",
	"license": "MIT",
	"author": "Jan T. Sott",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/idleberg/yeoman-generator.git"
	},
	"keywords": [
		"yeoman-generator",
		"clack-prompts",
		"clack",
		"eta",
		"yeoman"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"engines": {
		"node": ">=22.21.0"
	},
	"files": [
		"dist/",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"lint": "concurrently --prefix-colors blue,magenta npm:lint:*",
		"lint:biome": "biome check",
		"lint:e18e": "e18e-cli analyze",
		"prepack": "npm run build",
		"publish:jsr": "deno publish",
		"publish:npm": "np",
		"test": "#vitest run"
	},
	"dependencies": {
		"@yeoman/adapter": "^5.0.0",
		"glob": "^13.0.6",
		"is-binary-path": "^3.0.0",
		"kleur": "^4.1.5",
		"mem-fs-editor": "^12.0.8",
		"yeoman-adapter-clack": "^0.5.0",
		"yeoman-environment": "^6.3.0",
		"yeoman-generator": "^8.3.0"
	},
	"devDependencies": {
		"@clack/prompts": "^1.7.0",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@idleberg/configs": "^0.4.6",
		"@types/node": "^26.4.1",
		"@vitest/coverage-v8": "^5.0.0",
		"concurrently": "^10.0.5",
		"np": "^12.1.0",
		"tsdown": "0.23.0",
		"typescript": "^6.0.3",
		"vitest": "^5.0.0"
	},
	"peerDependencies": {
		"@clack/prompts": "^1.4.0",
		"eta": "^4.5.0"
	},
	"packageManager": "pnpm@11.2.2"
}
